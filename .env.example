DATABASE_URL=postgresql://user:password@localhost:5432/omega_complex
JWT_SECRET=cambia-esta-clave-en-produccion-minimo-32-caracteres

# Stripe (modo prueba durante el desarrollo). La pasarela los implementa el equipo.
STRIPE_SECRET_KEY=sk_test_tu_clave_de_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_secreto_de_webhook
NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n: recibe los codigos de verificacion y envia los correos.
# Es la unica via de salida de correo de la app.
N8N_WEBHOOK_URL=https://tu-n8n.example.com/webhook/omega-verificacion
N8N_WEBHOOK_SECRET=cambia-este-secreto-compartido-con-n8n

# Google OAuth (registro/inicio de sesion con Google).
# La redirect URI debe coincidir EXACTAMENTE con la registrada en Google Cloud:
#   {NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Codigos de verificacion
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_CODE_LENGTH=6

# Administrador que crea el seed
ADMIN_EMAIL=admin@omegacomplex.com
ADMIN_PASSWORD=cambia-esta-clave

# Solo para los scripts de QA (nunca en el repo)
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_EMPLOYEE_PASSWORD=