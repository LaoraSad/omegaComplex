// TODO(T2,T3): modelar User, Category, Facility, Schedule, Reservation, Payment, AccessLog.
// Este esqueleto permite `prisma generate` cuando se instalen las dependencias.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum nameRole {
  user
  admin
  employee
}

model Role {
  id    String   @id @default(uuid()) @db.uuid
  name  nameRole @default(user)
  users User[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  customer Customer?
}

model Customer {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @unique @db.Uuid
  document String?
  address  String?

  user User @relation(fields: [userId], references: [id])
}

model Category {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String?

  services Service[]
}

model Service {
  id          String @id @default(uuid()) @db.Uuid
  categoryId  String @db.Uuid
  name        String
  description String?
  price       Decimal
  capacity    Int

  category Category @relation(fields:[categoryId], references:[id])
}
